{
  "claims": [
    {
      "id": "BASE-PATH",
      "kind": "정상",
      "rule": "기본 포트 5173 의 `/blueprint/` 가 열린다",
      "test": "test_blueprint.py::test_scaffold_vite_base_blueprint"
    },
    {
      "id": "CHECK-OK",
      "kind": "정상",
      "rule": "`check` 가 `[OK]` 이고 경고를 읽어 처리했다",
      "test": "test_blueprint.py::test_check_passes_sample"
    },
    {
      "id": "PATH-EXISTS",
      "kind": "실패",
      "rule": "검사기가 `git rev-parse --show-toplevel` 기준으로 존재를 확인한다",
      "test": "test_blueprint.py::test_check_catches_missing_path"
    },
    {
      "id": "UNKNOWN-FIELD",
      "kind": "실패",
      "rule": "모르는 필드는 검사기가 거절한다",
      "test": "test_blueprint.py::test_check_rejects_unknown_field"
    },
    {
      "id": "CELL-ONCE",
      "kind": "실패",
      "rule": "`(lane,row)` 칸은 하나뿐",
      "test": "test_blueprint.py::test_check_rejects_cell_collision"
    },
    {
      "id": "STALE-DATE",
      "kind": "경계",
      "rule": "60일이 지나면 검사기가 경고한다",
      "test": "test_blueprint.py::test_stale_warns_but_passes"
    },
    {
      "id": "BOX-WIDTH",
      "kind": "경계",
      "rule": "넘으면 검사기가 경고한다",
      "test": "test_blueprint.py::test_wide_title_warns_but_passes"
    },
    {
      "id": "NO-OVERWRITE",
      "kind": "경계",
      "rule": "기존 폴더를 덮어쓰지 않는다",
      "test": "test_blueprint.py::test_scaffold_refuses_existing"
    },
    {
      "id": "BUN-MISSING",
      "kind": "도구오류",
      "rule": "매니저가 하나도 없으면 `brew install oven-sh/bun/bun`",
      "test": "test_blueprint.py::test_missing_bun_message"
    },
    {
      "id": "GIT-ROOT",
      "kind": "도구오류",
      "rule": "git 저장소 밖이면 `--root` 가 꼭 필요하다",
      "test": "test_blueprint.py::test_not_git_repo_needs_root"
    },
    {
      "id": "BLANK-LINES",
      "kind": "오탐",
      "rule": "줄마다 JSON 한 개를 적는다",
      "test": "test_blueprint.py::test_blank_lines_are_ignored"
    },
    {
      "id": "LATIN-WIDTH",
      "kind": "오탐",
      "rule": "`title` 은 한글 15자, `lines` 는 줄당 17자 안팎",
      "test": "test_blueprint.py::test_short_latin_title_does_not_warn"
    },
    {
      "id": "LOOPBACK-HOST",
      "kind": "경계",
      "rule": "`server.host: \"127.0.0.1\"` 로 고정해 충돌하면 다음 포트로 간다",
      "test": "test_blueprint.py::test_scaffold_pins_loopback_host"
    },
    {
      "id": "LINKS-HREF",
      "kind": "실패",
      "rule": "`links` 는 `[{label, href}]` 로 위쪽 목차 오른쪽에 붙는 이동 링크",
      "test": "test_blueprint.py::test_links_accept_paths_and_reject_script_urls"
    },
    {
      "id": "PM-NEUTRAL",
      "kind": "정상",
      "rule": "`package.json` 의 스크립트는 특정 매니저나 런타임을 부르지 않는다",
      "test": "test_blueprint.py::test_package_scripts_are_manager_neutral"
    },
    {
      "id": "NODE-FALLBACK",
      "kind": "경계",
      "rule": "없으면 node(22.6 이상)로 같은 `check.mjs` 를 돌린다",
      "test": "test_blueprint.py::test_check_runs_on_node_without_bun"
    },
    {
      "id": "PM-FLAG",
      "kind": "실패",
      "rule": "`--pm` 을 주지 않으면 PATH 에서 bun → pnpm → npm 순으로 처음 찾은 것을 쓴다",
      "test": "test_blueprint.py::test_pm_option_is_validated_and_printed"
    }
  ]
}
